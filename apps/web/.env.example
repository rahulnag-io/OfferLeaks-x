# Server-side only: URL of the FastAPI backend.
API_URL=http://localhost:8000

# --- Auth (Version 2) ---
# Auth.js session cookie encryption key. Generate with: npx auth secret
AUTH_SECRET=dev-only-insecure-secret-change-me-in-production-please
# Shared with the API's INTERNAL_API_SECRET -- gates /auth/oauth/google
# so only this server (never a browser) can upsert a user from a raw
# Google identity assertion.
INTERNAL_API_SECRET=dev-only-internal-secret-change-me

# Google OAuth app credentials (console.cloud.google.com -> Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
