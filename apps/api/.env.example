ENVIRONMENT=development
DEBUG=true

CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://offerleaks:offerleaks_dev@localhost:5432/offerleaks
REDIS_URL=redis://localhost:6379/0

# --- Auth (Version 2) ---
# Generate real secrets for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-in-production-please
# Shared with the Next.js app's INTERNAL_API_SECRET -- gates /auth/oauth/google.
INTERNAL_API_SECRET=dev-only-internal-secret-change-me

# --- Analyses (Version 3): object storage ---
# S3-compatible (Cloudflare R2 at MVP). Local dev default points at a
# MinIO container if you run one; otherwise point this at a real
# R2/S3 bucket. Required in any non-development environment.
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET=offerleaks-uploads-dev
STORAGE_ACCESS_KEY_ID=dev-only-access-key
STORAGE_SECRET_ACCESS_KEY=dev-only-secret-key
STORAGE_REGION=auto

# --- Analyses (Version 3): OCR (Google Document AI) ---
# Required in any non-development environment. GOOGLE_APPLICATION_CREDENTIALS
# (a service-account JSON key path) is read directly by the Google client
# library -- not duplicated as a setting here.
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=

# --- Analyses (Version 3): AI verdicts (Anthropic/Claude) ---
# Required in any non-development environment.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_PROMPT_VERSION=offer_letter_v1

# --- Credits (Version 4) ---
# Server-side only -- never accept these from a client. Free credits
# granted once per user at account creation; cost charged per analysis.
CREDIT_INITIAL_GRANT=3
CREDIT_COST_PER_ANALYSIS=1

# --- Analyses (Version 3): malware scanning (ClamAV) ---
# Set to false only for local dev when you don't have clamd running.
# Must stay true outside development -- enforced at boot, not just here.
MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Billing (M6): Razorpay ---
# Optional -- billing is off until these are set, and every other
# feature works fine without them. But if you set any one of the three,
# outside development the boot check requires all three together (a
# partially-filled-in .env is almost always a mistake, not an
# intentional "billing half-enabled" state). See BILLING.md for how to
# obtain each of these and finish the one-time Razorpay dashboard setup
# (webhook URL, Pro plan creation).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Company Signal & Reputation (M7) ---
# No credentials required for any of these -- domain-age lookup uses
# free RDAP (no API key), website reachability is a plain outbound
# HTTP(S) check, and everything else here is a timeout/cache/rate-limit
# knob. All have sane defaults (`core/config.py`); only override if you
# need a different RDAP bootstrap proxy or want tighter/looser cost
# control. See `docs/company_signal.md` for how the pieces fit together.
RDAP_BASE_URL=https://rdap.org/domain
DOMAIN_AGE_REQUEST_TIMEOUT_SECONDS=8.0
WEBSITE_REACHABILITY_TIMEOUT_SECONDS=6.0
COMPANY_PROFILE_STALE_AFTER_SECONDS=604800
COMPANY_PROFILE_REDIS_TTL_SECONDS=86400
COMPANY_LOOKUP_RATE_LIMIT_PER_MINUTE=20
COMPANY_LOOKUP_LOCK_SECONDS=30

# --- Structured Reporting + Reuse Features (M8) ---
# No credentials required -- reporting/analytics/comparison are all
# deterministic/query-layer features. All have sane defaults
# (`core/config.py`); only override to change the duplicate-detection
# window/sensitivity or the internal reputation-score curve. See
# `docs/reports.md`.
REPORT_DUPLICATE_WINDOW_HOURS=720
REPORT_DUPLICATE_SIMILARITY_THRESHOLD=0.72
REPORT_REPUTATION_SCORE_SATURATION_COUNT=5
